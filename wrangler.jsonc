{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elropero-magico-platform",
  "main": ".open-next/worker.js",
  // No bajar esta fecha sin revisar: fija las APIs del runtime de Workers.
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    // Requerido por Next.js en Workers (node:crypto, Buffer, etc.)
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Sin Hyperdrive: la DB va por driver Neon WebSocket directo (ver src/db/index.ts
  // y NEON_DATABASE_URL). Hyperdrive cerraba sockets ociosos y pg los reutilizaba
  // muertos → 500 intermitentes. Si algún día se quiere caché de Hyperdrive,
  // re-agregar aquí el bloque "hyperdrive" con un id válido.
}
