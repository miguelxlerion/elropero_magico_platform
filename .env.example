# Requeridas para dev/build (el build exige DATABASE_URL aunque sea dummy local)
DATABASE_URL=postgres://localhost:5432/el_ropero_fusion
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (lib/supabase client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pagos / notificaciones / IA
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
OPENAI_API_KEY=

# Instagram (sección /instagram) a través de Behold: crea el feed en app.behold.so y pega acá la
# URL del JSON feed (https://feeds.behold.so/XXXX) o solo el identificador. Sin esto, la sección
# muestra las instrucciones de conexión en lugar de la rejilla. Behold exige cuenta Business o Creador.
BEHOLD_FEED_URL=

# Acceso demo al panel admin (opcional). Solo si defines las dos, /login muestra la tarjeta de
# credenciales y `npm run db:seed` crea el admin. En produccion se dejan vacias: la tarjeta
# desaparece y la clave del administrador no viaja al navegador.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
