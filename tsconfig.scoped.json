{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    "src/types/**/*.ts",
    "src/lib/**/*.ts",
    "src/hooks/**/*.ts",
    "src/app/api/**/route.ts",
    "src/app/(shop)/instagram/page.tsx",
    "src/app/(shop)/manual/page.tsx",
    "src/components/instagram/**/*.tsx",
    "src/components/manual/**/*.tsx",
    "src/components/checkout/**/*.tsx"
  ]
}
